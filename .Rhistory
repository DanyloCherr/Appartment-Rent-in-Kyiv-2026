model_full1_2_temp2 <- lm(Ціна ~ . - Євро, data = model1_df_temp)
summary(model_full1_2_temp2)
# ==== 3) МУЛЬТИКОЛІНЕАРНІСТЬ-2. VIF, ЧИСЛО ОБУМОВЛЕНОСТІ ====
model1_df_norm_temp2 <- as.data.frame(lapply(model1_df_temp, unit_length_scale))
model_full1_2_norm_temp2 <- lm(Ціна ~ . - Євро_Долар - Долар, data = model1_df_norm_temp2)
vif(model_full1_2_norm_temp2)
