importf <- function(filename, date_format){
table <- import(get_csv_name(filename))
# # Якщо у даті бракує
# format1 <- grepl("^\\d{4}-\\d{1,2}$", table[1, 1])
# if(format1){
#   table[, 1] <- paste0(table[, 1], "-01") # paste0 не має роздільника, на відміну від paste
#   table[, 1] <- as.Date(table[, 1], format = "%Y-%m-%d")
# }
table[, 1] <- as.Date(table[, 1], format = date_format)
table[, -1] <- sapply(table[, 2], function(x){
x <- gsub(",", ".", x)
x <- gsub("[^0-9.]", "", x)
as.double(x)
})
return(table)
}
