clean_formula <- function(model) {
rhs <- as.character(formula(model))[3]
rhs <- gsub("(I\\()+", "I(", rhs)
rhs <- gsub("\\)+", ")", rhs)
rhs <- gsub(" \\- ", " + -", rhs)
terms <- strsplit(rhs, " \\+ ")[[1]]
terms <- trimws(terms)
added <- terms[!grepl("^-", terms)]
removed <- gsub("^-", "", terms[grepl("^-", terms)])
add_counts <- table(added)
rem_counts <- table(removed)
all_vars <- union(names(add_counts), names(rem_counts))
final_terms <- c()
for (v in all_vars) {
n_add <- ifelse(v %in% names(add_counts), add_counts[v], 0)
n_rem <- ifelse(v %in% names(rem_counts), rem_counts[v], 0)
if (n_add > n_rem) {
final_terms <- c(final_terms, rep(v, n_add - n_rem))
}
}
y_name <- as.character(formula(model))[2]
formula_clean <- as.formula(paste(y_name, "~", paste(final_terms, collapse = " + ")))
return(formula_clean)
}
for(m in final_modelsq){
print(formula(m), showEnv = F)
}
# ======== 8) ВАЛІДАЦІЯ МОДЕЛІ ========
final_models_lmq <- lapply(final_modelsq, function(m) lm(clean_formula(m), data = df_longq))
for(m in final_models_lmq){
print(formula(m), showEnv = F)
}
clean_formula <- function(model) {
term_labels <- attr(terms(model), "term.labels")
y_name <- as.character(formula(model))[2]
formula_clean <- as.formula(paste(y_name, "~", paste(term_labels, collapse = " + ")))
return(formula_clean)
}
