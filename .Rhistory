acf_cr <- function(model){
data <- model$model
par(mfrow = c(1, 3))
for(room in c("1", "2", "3")){
e <- residuals(model)[data[["Кімнатність"]] = room]
acf_cr <- function(model){
data <- model$model
par(mfrow = c(1, 3))
for(room in c("1", "2", "3")){
e <- residuals(model)[data[["Кімнатність"]] == room]
acf(e, main = paste("ACF -", room, "кімнатні"))
}
par(mfrow = c(1, 1))
}
