model_cor_matrix <- function(model_df, title_param){
# title_param - яку змінну було додано до даних
cor_matrix <- cor(model_df, use = "complete.obs")
corrplot(cor_matrix, method = "circle", type = "upper",
addCoef.col = "black", tl.col = "black",
mar = c(2, 0, 0, 0))
mtext(title_param, side = 1, line = 2, cex = 1.2)
return(cor_matrix)
}
model_cor_matrix(model1_df, "")
model1_df$ІЦЖ <- (model1_df$ІЦЖП + model1_df$ІЦЖВ) / 2
model1_df <- model1_df[!names(model1_df) %in% c("ІЦЖП", "ІЦЖВ")]
model_cor_matrix(model1_df, "")
# ----- 46 СПОСТЕРЕЖЕНЬ -----
# ==== 1) МУЛЬТИКОЛІНЕАРНІСТЬ-1. КОРЕЛЯЦІЙНА МАТРИЦЯ ====
model_cor_matrix(model_df_2[, -1], "")
model1_df <- upd_model_df(model_df_2, remove = "Ч", room_num = 1)
colnames(model1_df)[colnames(model1_df) == "К1"] <- "Ціна"
model_cor_matrix(model1_df, "")
model1_df <- model1_df[!names(model1_df) %in% c("ІЦЖП")]
model_cor_matrix(model1_df, "")
model1_df <- model1_df[!names(model1_df) %in% c("ІЦЖП", "ЧистГрнКред")]
model_cor_matrix(model1_df, "")
model1_df$`Євро_Долар` <- model1_df$Євро / model1_df$Долар
model1_df <- model1_df[!names(model1_df) %in% c("Євро", "Долар")]
model_cor_matrix(model1_df, "")
