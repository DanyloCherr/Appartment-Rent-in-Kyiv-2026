dwtest(model_log1_75)
boxTidwell(log(Ціна) ~ Долар + Євро + ІФС + ІГР + ІЦБ + ЧисНасел + РівДолар,
data = model1_75_df)
boxTidwell(log(Ціна) ~ .,
other.x = ~ Долар + Євро + ІФС + ІГР + ІЦБ + ЧисНасел + РівДолар,
data = model1_75_df)
