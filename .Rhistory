residuals_regressors_plot_gg <- function(model, nr_nc, type = "rstudent") {
predictors <- attr(terms(model), "term.labels")
par(mfrow = nr_nc)
for (pred in predictors) {
x_vals <- model.matrix(model)[, pred]
if (type == "rstudent") {
res_vals <- rstudent(model)
} else if (type == "rstandard") {
res_vals <- rstandard(model)
} else {
res_vals <- residuals(model)
}
plot(x_vals, res_vals,
col = "steelblue", pch = 19, cex = 0.8,
main = paste("Залишки vs", pred),
xlab = pred, ylab = "Залишки")
abline(h = 0, col = "gray50", lty = 2)
if (type %in% c("rstudent", "rstandard")) {
abline(h = c(-2, 2), col = "darkred", lty = 3)
}
}
par(mfrow = c(1, 1))
}
residuals_regressors_plot_gg(final_models_lmq[[10]], c(3, 3)) # Значна недооцінка К1; незначна - К3.
residuals_regressors_plot_gg <- function(model, nr_nc, type = "rstudent") {
predictors <- attr(terms(model), "term.labels")
# Отримати матрицю регресорів та її назви
mm <- model.matrix(model)
mm_cols <- colnames(mm)
# Прибрати інтерцепт
mm_cols <- mm_cols[mm_cols != "(Intercept)"]
par(mfrow = nr_nc)
for (pred in predictors) {
# Знайти відповідний стовпець у model.matrix
# (для взаємодій назва може відрізнятися)
matching_col <- grep(pred, mm_cols, fixed = TRUE)[1]
if (is.na(matching_col)) {
cat("Пропущено:", pred, "— не знайдено в model.matrix\n")
next
}
x_vals <- mm[, matching_col]
if (type == "rstudent") {
res_vals <- rstudent(model)
} else if (type == "rstandard") {
res_vals <- rstandard(model)
} else {
res_vals <- residuals(model)
}
plot(x_vals, res_vals,
col = "steelblue", pch = 19, cex = 0.8,
main = paste("Залишки vs", pred),
xlab = pred, ylab = "Залишки")
abline(h = 0, col = "gray50", lty = 2)
if (type %in% c("rstudent", "rstandard")) {
abline(h = c(-2, 2), col = "darkred", lty = 3)
}
}
par(mfrow = c(1, 1))
}
residuals_regressors_plot_gg(final_models_lmq[[10]], c(3, 3)) # Значна недооцінка К1; незначна - К3.
residuals_regressors_plot <- function(model, nr_nc, type = "response") {
predictors <- attr(terms(model), "term.labels")
par(mfrow = nr_nc)
for (pred in predictors) {
# Якщо це взаємодія (містить ":") — будуємо вручну
if (grepl(":", pred)) {
x_vals <- model.matrix(model)[, pred]
res_vals <- switch(type,
"rstudent"  = rstudent(model),
"rstandard" = rstandard(model),
residuals(model)
)
plot(x_vals, res_vals,
col = "steelblue", pch = 19, cex = 0.8,
main = paste("Залишки vs", pred),
xlab = pred, ylab = "Залишки")
lines(lowess(x_vals, res_vals), col = "red", lwd = 2)
abline(h = 0, col = "gray50", lty = 2)
if (type %in% c("rstudent", "rstandard")) {
abline(h = c(-2, 2), col = "darkred", lty = 3)
}
} else {
# Звичайна змінна — використовуємо residualPlot
residualPlot(model, variable = pred,
type = type,
col = "steelblue",
pch = 19,
cex = 1,
id = list(n = 3, col = "red", cex = 1),
col.quad = "white",
grid = TRUE,
main = "",
xlab = pred,
ylab = "")
}
}
par(mfrow = c(1, 1))
}
residuals_regressors_plot(final_models_lmq[[10]], c(3, 3)) # Значна недооцінка К1; незначна - К3.
residuals_regressors_plot <- function(model, nr_nc, type = "response") {
predictors <- attr(terms(model), "term.labels")
par(mfrow = nr_nc)
for (pred in predictors) {
if (grepl(":", pred)) {
x_vals <- model.matrix(model)[, pred]
res_vals <- switch(type,
"rstudent"  = rstudent(model),
"rstandard" = rstandard(model),
residuals(model)
)
plot(x_vals, res_vals,
col = "steelblue", pch = 19, cex = 1,
xlab = pred, ylab = "")
abline(h = 0, col = "gray50", lty = 2)
} else {
residualPlot(model, variable = pred,
type = type,
col = "steelblue",
pch = 19,
cex = 1,
id = list(n = 3, col = "red", cex = 1),
col.quad = "white",
grid = TRUE,
main = "",
xlab = pred,
ylab = "")
}
}
par(mfrow = c(1, 1))
}
residuals_regressors_plot(final_models_lmq[[10]], c(3, 3)) # Значна недооцінка К1; незначна - К3.
residuals_regressors_plot <- function(model, nr_nc, type = "response") {
predictors <- attr(terms(model), "term.labels")
par(mfrow = nr_nc)
for (pred in predictors) {
if (grepl(":", pred)) {
x_vals <- model.matrix(model)[, pred]
res_vals <- switch(type,
"rstudent"  = rstudent(model),
"rstandard" = rstandard(model),
residuals(model)
)
plot(x_vals, res_vals,
col = "steelblue", pch = 19, cex = 1,
xlab = pred, ylab = "")
abline(h = 0, col = "gray50", lty = 2)
grid(col = "gray80", lty = "dotted")
} else {
residualPlot(model, variable = pred,
type = type,
col = "steelblue",
pch = 19,
cex = 1,
id = list(n = 3, col = "red", cex = 1),
col.quad = "white",
grid = TRUE,
main = "",
xlab = pred,
ylab = "")
}
}
par(mfrow = c(1, 1))
}
residuals_regressors_plot(final_models_lmq[[10]], c(3, 3)) # Значна недооцінка К1; незначна - К3.
residuals_regressors_plot <- function(model, nr_nc, type = "response") {
predictors <- attr(terms(model), "term.labels")
par(mfrow = nr_nc)
for (pred in predictors) {
if (grepl(":", pred)) {
x_vals <- model.matrix(model)[, pred]
res_vals <- switch(type,
"rstudent"  = rstudent(model),
"rstandard" = rstandard(model),
residuals(model)
)
plot(x_vals, res_vals,
