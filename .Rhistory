aic_base <- AIC(lm2)
bic_base <- BIC(lm2)
interactions_result <- observe_best_interactions(lm2, model3_df, top_n = 10)
# 2. ІЦБ × ІндМатСтан | ΔAIC = 12.04 | p = 0.0007
