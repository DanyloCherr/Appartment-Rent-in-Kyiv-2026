importf <- function(filename){ # import and format
table <- import(get_csv_name(filename))
# Якщо задано YYYY-MM, то дописуємо перше число місяця
format1 <- grepl("^\\d{4}-\\d{1,2}$", table[1, 1])
if(format1){
table[, 1] <- paste0(table[, 1], "-01")
table[, 1] <- as.Date(ymd(table[, 1]), format = "%d-%m-%Y")
}
# Якщо задано DD-MM-YY
else{
table[, 1] <- as.Date(table[, 1], format = "%d.%m.%Y")
}
table[, 2] <- sapply(table[, 2], function(x){
x <- gsub(",", ".", x)
x <- gsub("[^0-9.]", "", x)
as.double(x)
})
return(table)
}
