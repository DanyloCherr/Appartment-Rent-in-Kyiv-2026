unit_length_scale <- function(x){
result <- (x - mean(x)) / sqrt(x^2)
return(result)
}
unit_length_scale <- function(x){
result <- (x - mean(x)) / sqrt(x^2)
return(result)
}
# ==== 2) МУЛЬТИКОЛІНЕАРНІСТЬ-2. VIF, ЧИСЛО ОБУМОВЛЕНОСТІ ====
# Для діагнозтики мультиколінеарності стандартизуємо регресори за одиничною довжиною.
# Проте надалі будемо працювати з оригінальними одиницями.
model1_75_df_norm <- lapply(model1_75_df_norm, unit_length_scale)
model1_75_df_norm <- lapply(model1_75_df, unit_length_scale)
colSums(model1_75_df_norm)
head(model1_75_df_norm)
colSums(model1_75_df_norm[, ])
colSums(model1_75_df_norm)
class(model1_75_df_norm)
model1_75_df_norm <- as.data.frame(lapply(model1_75_df, unit_length_scale))
class(model1_75_df_norm)
colSums(model1_75_df_norm)
colSums(model1_75_df_norm^2)
unit_length_scale <- function(x){
result <- (x - mean(x)) / sqrt(x - mean(x))
return(result)
}
# ==== 1) ПОВНА МОДЕЛЬ ====
model_full1_75 <- lm(Ціна ~ ., data = model1_75_df)
summary(model_full1_75)
model1_75_df_norm <- as.data.frame(lapply(model1_75_df, unit_length_scale))
colSums(model1_75_df_norm^2)
unit_length_scale <- function(x){ # Передаємо один стовпець
centered <- x - mean(x)
result <- centered / sqrt(sum(centered^2))
return(result)
}
model1_75_df_norm <- as.data.frame(lapply(model1_75_df, unit_length_scale))
colSums(model1_75_df_norm^2)
colMeans(model1_75_df_norm^2)
head(model1_75_df_norm, 3)
colMeans(model1_75_df_norm^2)
colMeans(model1_75_df_norm)
