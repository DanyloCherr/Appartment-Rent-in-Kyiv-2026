models_summary(list(inter_lm))
aic_base - AIC(inter_lm) # 14.11481
bic_base - BIC(inter_lm) # 14.11481
inter_lm3 <- inter_lm
assumptions_check(inter_lm3)
# 3. ІндМатСтан × ЧистГрнКред | ΔAIC = 11.23 | p = 0.0010
