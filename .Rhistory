upd_model_df <- function(model_df, remove = c(), room_num = 1){
K_remove <- switch(room_num,
"1" = c("К2", "К3"),
"2" = c("К1", "К3"),
"3" = c("К1", "К2"),
c()
)
result <- model_df[, !names(model_df) %in% c(K_remove, "Дата", remove)]
return(result)
}
