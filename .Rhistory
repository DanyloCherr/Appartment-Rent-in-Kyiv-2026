model_EUR <- update(lm1, . ~ . - Євро_Долар + Євро)
model_USD <- update(lm1, . ~ . - Євро_Долар + Долар)
models_summary(append(best_models1_2, list(model_EUR, model_USD)))
# ----- МОДЕЛЬ ІЗ ЄВРО, але без ІЦБ, ІЦЖП ----
