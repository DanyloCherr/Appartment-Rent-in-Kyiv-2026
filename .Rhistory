importf <- function(filename, date_format){
table <- import(get_csv_name(filename))
no_day_format <- grepl("^\\d{4}-\\{1,2}$", table[1, 1])
table[, 1] <- as.Date(table[, 1], format = date_format)
table[, -1] <- sapply(table[, -1], function(x){
x <- gsub(",", ".", x)
x <- gsub("[^0-9.]", "", x)
as.double(x)
})
return(table)
}
